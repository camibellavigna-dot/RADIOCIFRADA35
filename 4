create extension if not exists pgcrypto;

create table if not exists public.user_roles (
  user_id uuid primary key references auth.users(id) on delete cascade,
  role text not null check (role in ('admin', 'listener'))
);

create table if not exists public.tracks (
  id uuid primary key default gen_random_uuid(),
  title text not null,
  type text not null check (type in ('mp3', 'youtube')),
  url text,
  video_id text,
  created_by uuid references auth.users(id),
  created_at timestamptz not null default now()
);

create table if not exists public.station_state (
  id integer primary key default 1 check (id = 1),
  track_id uuid references public.tracks(id) on delete set null,
  updated_by uuid references auth.users(id),
  updated_at timestamptz not null default now()
);

insert into public.station_state (id)
values (1)
on conflict (id) do nothing;

create or replace function public.is_admin()
returns boolean
language sql
stable
security definer
set search_path = public
as $$
  select exists (
    select 1
    from public.user_roles
    where user_id = auth.uid()
      and role = 'admin'
  );
$$;

revoke all on function public.is_admin() from public;
grant execute on function public.is_admin() to authenticated;

alter table public.user_roles enable row level security;
alter table public.tracks enable row level security;
alter table public.station_state enable row level security;

create policy "Users can read their own role"
on public.user_roles for select
to authenticated
using (user_id = auth.uid());

create policy "Admins can manage roles"
on public.user_roles for all
to authenticated
using (public.is_admin())
with check (public.is_admin());

create policy "Anyone can read tracks"
on public.tracks for select
to anon, authenticated
using (true);

create policy "Admins can add tracks"
on public.tracks for insert
to authenticated
with check (public.is_admin());

create policy "Admins can update tracks"
on public.tracks for update
to authenticated
using (public.is_admin())
with check (public.is_admin());

create policy "Admins can delete tracks"
on public.tracks for delete
to authenticated
using (public.is_admin());

create policy "Anyone can read station state"
on public.station_state for select
to anon, authenticated
using (true);

create policy "Admins can update station state"
on public.station_state for update
to authenticated
using (public.is_admin())
with check (public.is_admin());

-- Bucket público para los MP3 de la radio.
insert into storage.buckets (id, name, public, file_size_limit, allowed_mime_types)
values ('radio-mp3', 'radio-mp3', true, 15728640, array['audio/mpeg'])
on conflict (id) do nothing;

create policy "Public can read radio MP3 files"
on storage.objects for select
to anon, authenticated
using (bucket_id = 'radio-mp3');

create policy "Admins can upload radio MP3 files"
on storage.objects for insert
to authenticated
with check (bucket_id = 'radio-mp3' and public.is_admin());

create policy "Admins can update radio MP3 files"
on storage.objects for update
to authenticated
using (bucket_id = 'radio-mp3' and public.is_admin())
with check (bucket_id = 'radio-mp3' and public.is_admin());

create policy "Admins can delete radio MP3 files"
on storage.objects for delete
to authenticated
using (bucket_id = 'radio-mp3' and public.is_admin());

